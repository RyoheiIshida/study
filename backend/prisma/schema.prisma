// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  CHILD
}

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  passwordHash String
  role         Role             @default(CHILD)
  createdAt    DateTime         @default(now())
  progress     ProgressRecord[]
  quizAttempts QuizAttempt[]
  answerRecords AnswerRecord[]

  parentId Int?
  parent   User?  @relation("ParentChild", fields: [parentId], references: [id])
  children User[] @relation("ParentChild")

  sentInvites      FamilyInvite[]
  purchaseRequests PurchaseRequest[] @relation("ChildRequests")
  handledRequests  PurchaseRequest[] @relation("ParentRequests")
}

model FamilyInvite {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  parentId  Int
  parent    User      @relation(fields: [parentId], references: [id])
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

enum PurchaseRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  HANDED_OVER
  RECEIVED
  CANCELLED
}

model PurchaseRequest {
  id           Int                   @id @default(autoincrement())
  childId      Int
  child        User                  @relation("ChildRequests", fields: [childId], references: [id])
  parentId     Int
  parent       User                  @relation("ParentRequests", fields: [parentId], references: [id])
  pointsCost   Int
  rate         Float
  cashAmount   Int
  memo         String?
  status       PurchaseRequestStatus @default(REQUESTED)
  rejectReason String?
  requestedAt  DateTime              @default(now())
  respondedAt  DateTime?
  handedOverAt DateTime?
  receivedAt   DateTime?

  @@index([childId, status])
  @@index([parentId, status])
}

model Quiz {
  id              String           @id
  title           String
  subject         String
  grade           String
  description     String
  questions       Question[]
  createdAt       DateTime         @default(now())
  progressRecords ProgressRecord[]
  quizAttempts    QuizAttempt[]
  answerRecords   AnswerRecord[]
}

model Question {
  id          String  @id
  quiz        Quiz    @relation(fields: [quizId], references: [id])
  quizId      String
  text        String
  answer      String
  options     String[] @default([])
  graphOptions Json    @default("[]")
  explanation String?
  order       Int
}

model ProgressRecord {
  id         Int      @id @default(autoincrement())
  username   String
  user       User     @relation(fields: [username], references: [username])
  quiz       Quiz     @relation(fields: [quizId], references: [id])
  quizId     String
  completed  Int
  total      Int
  correct    Int
  streak     Int
  lastPlayed DateTime

  @@unique([username, quizId])
}

model QuizAttempt {
  id       Int      @id @default(autoincrement())
  username String
  user     User     @relation(fields: [username], references: [username])
  quiz     Quiz     @relation(fields: [quizId], references: [id])
  quizId   String
  total    Int
  correct  Int
  streak   Int
  playedAt DateTime @default(now())

  @@index([username, playedAt])
}

model AnswerRecord {
  id         Int      @id @default(autoincrement())
  username   String
  user       User     @relation(fields: [username], references: [username])
  quiz       Quiz     @relation(fields: [quizId], references: [id])
  quizId     String
  questionId String
  difficulty String
  isCorrect  Boolean
  elapsedMs  Int
  answeredAt DateTime @default(now())

  @@index([username, difficulty, answeredAt])
}
